# Production runtime configuration. Copy to .env, replace every blank value,
# and keep the resulting file out of source control.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Direct Spring Boot connection (for Docker Compose, DB_URL/DB_USERNAME/
# DB_PASSWORD are derived from MYSQL_* below).
DB_URL=jdbc:mysql://db.example.com:3306/techstore?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=techstore
DB_PASSWORD=
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# Comma-separated trusted browser origins. Do not use * in production.
CORS_ALLOWED_ORIGINS=https://store.example.com

# Generate with .\scripts\new-production-jwt-secret.ps1. This must be a new
# production-only value of at least 32 characters; never reuse the dev secret.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D

# Docker Compose database and public frontend settings.
MYSQL_DATABASE=techstore
MYSQL_USER=techstore
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
FRONTEND_PORT=8080

# Public store information used in API documentation and email templates.
BRAND_NAME=Đăng Tùng Mobile
BRAND_INDUSTRY=Kinh doanh phụ kiện điện thoại.
BRAND_ADDRESS=Xóm Lê Lợi, Thôn Cập Thượng, Phường Nam Đồng, TP Hải Phòng
BRAND_CONTACT_PHONE=0867116863
BRAND_CONTACT_EMAIL=hoanghd064@gmail.com
# Leave optional public details blank until they are confirmed.
BRAND_OPENING_HOURS=
BRAND_ZALO_URL=
BRAND_SOCIAL_URL=
BRAND_MAP_URL=
BRAND_WARRANTY_POLICY_URL=

# Password-reset links are single-use and expire after this ISO-8601 duration.
PASSWORD_RESET_TOKEN_TTL=PT30M
PASSWORD_RESET_FRONTEND_URL=https://store.example.com

# SMTP delivery for password-reset emails. MAIL_FROM is the sender identity and
# is intentionally separate from the public contact email above. Use provider
# credentials in your local environment or deployment secret store; never
# commit actual values.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000

# Persistent upload paths. Docker Compose overrides these with its named volume.
UPLOAD_DIR=uploads/products
UPLOAD_BASE_DIR=uploads
