SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/techstore?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change_me
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D

# Password-reset links are single-use and expire after this ISO-8601 duration.
PASSWORD_RESET_TOKEN_TTL=PT30M
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173

# SMTP delivery for password-reset emails. Use provider credentials in your local
# environment or deployment secret store; never commit actual values.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_smtp_username
MAIL_PASSWORD=replace_with_smtp_password
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
