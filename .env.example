SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/techstore?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change_me
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D

# Docker Compose database and public frontend settings. These are consumed by
# docker-compose.yml; DB_URL/DB_USERNAME/DB_PASSWORD above remain useful when
# running Spring Boot directly on the host.
MYSQL_DATABASE=techstore
MYSQL_USER=techstore
MYSQL_PASSWORD=replace_with_a_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password
FRONTEND_PORT=8080

# Public store information used in API documentation and email templates.
BRAND_NAME=Đăng Tùng Mobile
BRAND_INDUSTRY=Kinh doanh phụ kiện điện thoại.
BRAND_ADDRESS=Xóm Lê Lợi, Thôn Cập Thượng, Phường Nam Đồng, TP Hải Phòng
BRAND_CONTACT_PHONE=0867116863
BRAND_CONTACT_EMAIL=hoanghd064@gmail.com
# Leave optional public details blank until they are confirmed.
BRAND_OPENING_HOURS=
BRAND_ZALO_URL=
BRAND_SOCIAL_URL=
BRAND_MAP_URL=
BRAND_WARRANTY_POLICY_URL=

# Password-reset links are single-use and expire after this ISO-8601 duration.
PASSWORD_RESET_TOKEN_TTL=PT30M
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173

# SMTP delivery for password-reset emails. MAIL_FROM is the sender identity and
# is intentionally separate from the public contact email above. Use provider
# credentials in your local environment or deployment secret store; never
# commit actual values.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_smtp_username
MAIL_PASSWORD=replace_with_smtp_password
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
