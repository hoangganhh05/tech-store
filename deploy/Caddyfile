{
	email {$ACME_EMAIL}
}

# Caddy automatically obtains and renews the TLS certificate for APP_DOMAIN,
# redirects HTTP to HTTPS, and only exposes the frontend reverse proxy.
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy frontend:80
}
